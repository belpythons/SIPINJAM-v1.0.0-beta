APP_NAME=SiPinjam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipinjam
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=emailkampus@gmail.com
MAIL_PASSWORD=isi_dengan_16_digit_app_password_google
MAIL_ENCRYPTION=smtps
MAIL_FROM_ADDRESS="emailkampus@gmail.com"
MAIL_FROM_NAME="Admin SIPINJAM"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=isi_dengan_client_id_dari_google_cloud
GOOGLE_CLIENT_SECRET=isi_dengan_client_secret_dari_google_cloud
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FONNTE_TOKEN=isi_dengan_token_fonnte
VITE_ADMIN_WA_NUMBER=isi_nomor_wa_admin
NODE_BINARY_PATH=
NPM_BINARY_PATH=

# ── SiPinjam (config/sipinjam.php) ─────────────────────────────────────────
# Domain email kampus yang boleh login lewat Google, dipisahkan koma.
SIPINJAM_ALLOWED_EMAIL_DOMAINS=stitek.ac.id
# true = akun dibuat otomatis saat login Google pertama (domain tetap diperiksa).
# false = akun harus dibuat lebih dulu oleh admin.
SIPINJAM_AUTO_PROVISION_GOOGLE_USERS=true

# Kop surat pada dokumen resmi.
SIPINJAM_KOP_YAYASAN="Yayasan Pendidikan Bessai Berinta"
SIPINJAM_KOP_INSTITUSI="Sekolah Tinggi Teknologi Bontang"
SIPINJAM_KOP_ALAMAT="Jl. Brigjend Katamso No.40, Bontang Utara, Kota Bontang, Kalimantan Timur 75313"
SIPINJAM_KOP_WEBSITE=stitek.ac.id
SIPINJAM_KOP_TELEPON="(0548) 22212"
SIPINJAM_KOP_LOGO_PATH=logo.png

# WAJIB DIISI sebelum dipakai resmi — nilai default berupa placeholder mencolok.
SIPINJAM_TTD_PEJABAT_NAMA="[ISI NAMA PEJABAT]"
SIPINJAM_TTD_PEJABAT_JABATAN="[ISI JABATAN PEJABAT]"
SIPINJAM_TTD_PEJABAT_NIP="[ISI NIP PEJABAT]"
SIPINJAM_TTD_PENGELOLA_NAMA="[ISI NAMA PENGELOLA ASET]"
SIPINJAM_TTD_PENGELOLA_JABATAN="[ISI JABATAN PENGELOLA ASET]"
SIPINJAM_TTD_PENGELOLA_NIP="[ISI NIP PENGELOLA ASET]"
SIPINJAM_TTD_PENERIMA_NAMA="[ISI NAMA PENERIMA SURAT]"
SIPINJAM_TTD_PENERIMA_JABATAN="[ISI JABATAN PENERIMA SURAT]"

SIPINJAM_SURAT_FORMAT_NOMOR="{urut}/INT/SIPINJAM/{tahun}"
SIPINJAM_SURAT_KOTA=Bontang
SIPINJAM_SURAT_ZONA_WAKTU=WITA

# Set false bila Chromium berjalan sebagai user non-root.
SIPINJAM_PDF_NO_SANDBOX=true
